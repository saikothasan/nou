{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nou",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "dispatch_namespaces": [
    {
      "binding": "DISPATCHER",
      "namespace": "vibesdk"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "cd490acf88164f058920a13ca8622c5b"
    }
  ]
}
